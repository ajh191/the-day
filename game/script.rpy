image white = Solid("#ffffff")

default player_name = "이준"

default item_umbrella = False
default item_pencil = False
default item_rooftop_key = False
default item_watch = False
default item_dain_photo = False
default item_keyring = False

define p = Character("[player_name]", color="#ffffff")
define s = Character('소은', color="#fbd6b6")
define t = Character('태은', color="#cde5ff")
define d = Character('다인', color="#16173a", outlines=[(1.4,"#ffffff",0,0)])
define f = Character('친구들', color="#c1c0c0d2")
define s_mem = Character("소은", color="#fbd6b6", what_italic=True, what_color="#e8d8bf")

define fade = Fade(0.5, 0.2, 1.0, color="#000000")
define flash = Fade(0.5, 0.2, 1.2, color="#ffffff")

transform character_size:
    zoom 0.95
    center

transform memory_in:
    matrixcolor SaturationMatrix(0.35) * TintMatrix("#f2dcc0")
    blur 12
    linear 1.2 blur 1.5

# 1장 - 그날로부터, 1년
label start:
    scene white
    $ player_name = renpy.input("이름을 입력해 주세요. (이름을 입력하지 않을 시 \"이준\"으로 자동 설정 됩니다.)", screen="input_center").strip()
    if not player_name:
        $ player_name = "이준"

    scene bg room with flash
    "알람이 울리기 전에 눈을 떴다."

    "요즘은 늘 그렇다. 알람보다 먼저 깨서, 한참을 천장만 본다."

    "책상 위에 노트 한 권이 놓여 있다."

    "소은의 스케치 노트다."

    "1년 전 그날, 길바닥에 떨어져 있던 걸 주워 온 뒤로 계속 이 방에 있다."

    "어젯밤에도 펼쳐 봤다. 펼치면 안 된다는 걸 알면서도."

    "마지막 장에는 내 얼굴이 그려져 있었다."

    "눈과 코와 웃는 입까지는 선이 또렷했다."
    "그 아래는 비어 있었다."
    "턱도 목도 없이, 흰 종이만 남아 있었다."

    "말을 하다 만 얼굴 같다."

    "소은은 이 그림을 끝내지 못했다."

    "나는 이 그림을 버리지 못했다."

    "노트를 덮고, 쓰레기통 앞까지 걸어갔다가, 되돌아와 서랍을 열었다."

    "가장 안쪽에 노트를 밀어 넣고 서랍을 닫았다."

    "버릴 수 있었으면, 진작 버렸겠지."

    scene bg classroom with fade
    "창으로 노을이 길게 들어온다."
    "뒤편 게시판에 색종이 장식이 절반쯤 붙어 있다."

    show dain normal at character_size with dissolve
    "방과 후의 교실에는 우리 둘뿐이다."

    "축제 게시판 담당은 제비뽑기에서 나와 다인이 걸렸다."
    "다른 애들은 진작 갔다."

    d "[player_name], 은행잎 좀 줘. 노란 거 말고, 더 노란 거."
    
    p "노란 거 말고 더 노란 거? 아니, 그게 뭔 소리야."

    d "색감이거든. 눈 달고 다니면서 그것도 몰라?"

    p "내 눈엔 다 은행잎인데."

    d "그러니까 넌 가위질이나 해."
    d "별은 이 선 따라서 오려."
    d "삐뚤게 자르면 처음부터 다시야."

    p "야, 이거 완전 노동 착취 아니냐. 이럴 거면 봉사시간이라도 줘."

    d "봉사시간은 무슨. 입만 열심히 일하네."

    "색종이가 한 장씩 별이 되고, 잎이 되어 갔다. 풀 냄새가 났다."

    "다인이 의자 위에 올라서서 게시판 맨 위 모서리를 눌러 붙이며 말했다."

    d "축제 날엔 여기 앞에서 다 같이 사진 찍자."
    d "우리가 만든 거라고 자랑해야지!"

    "\'축제 날\'이라는 말이 가위질 소리 사이로 떨어졌다."

    "손이 멈춘 걸 안 건, 가위 날이 종이의 선 바깥으로 나가 있는 걸 본 뒤였다."

    "창밖의 노을이 책상 위를 훑고 지나갔다."
    "1년 전 그날도, 이런 색이었다."

    d "...또 그런다."

    "다인은 이쪽을 보지 않고 말했다."
    "풀칠한 은행잎을 게시판에 누르는 손은 그대로였다."

    "모른 척하는 사람의 목소리였다."

    menu:
        "축제 얘기만 나오면, 좀 그래.":
            p "축제 얘기만 나오면, 좀 그래."

            "입 밖으로 나온 말이 생각보다 가볍게 떨어졌다."

            "다인이 잠깐 나를 봤다. 가위 소리도, 풀 소리도 나지 않았다."

            d "그럼 오늘은 그냥 '게시판'이라고 부르자."

            "그 이상은 묻지 않았다."
            "묻지 않는 방식으로, 다인은 늘 한 발 가까이 있다."

        "아무것도 아니야.":
            p "아무것도 아니야. 배고파서 그래. 오늘 급식 진짜 별로였잖아."

            "웃음이 얼굴에 붙는 게 느껴졌다."
            "이 웃음은 이제 손에 익었다."

            "다인은 더 묻지 않고 가위를 집어 들었다."

            "알고 있다는 걸 안다. 모른 척해 준다는 것도."
        
    "다인이 의자에서 내려와 풀통을 집어 들었다."

    hide dain normal with dissolve
    "한동안 종이 넘기는 소리와 가위 소리만 오갔다."

    "게시판 맨 위의 별을 마저 붙이려고 발끝을 세웠을 때, 누군가 내 옆을 스치듯 지나갔다."

    show taeeun normal at character_size with dissolve
    "뒷문 쪽으로 가는 전학생이었다."
    "이번 주 월요일에 전학 온 애."
    "이름은 태은."

    "또래로 보이는데, 어딘가 또래 같지 않은 얼굴이다."
    "아직 말을 섞어 본 적이 없다."

    t "...오랜만이네."

    "낮게 흘린 말이었다."
    "나를 향한 건지, 혼잣말인지 구분이 되지 않았다."

    "오랜만이라니."

    "나는 저 애를 월요일에 처음 봤다."

    "태은은 벌써 두어 걸음 멀어져 있었다."
    "걸음에 망설임이 없었다."

    menu:
        "...우리, 어디서 본 적 있어?":
            p "...우리, 어디서 본 적 있어?"

            "태은이 걸음을 멈췄다."
            "반쯤 돌아본 얼굴에는 표정이라고 부를 만한 게 없었다."

            t "글쎄. 그건 네가 기억할 일이지."

            "그러고는 다시 걸어갔다."
            "뒷문이 닫히는 소리가 났다."

        "그냥 보낸다.":
            "입을 열었다가, 다물었다."

            "묻지 않았다."
            "돌아올 대답이 무서웠던 건지, 그냥 귀찮았던 건지는 나도 모르겠다."

            "뒷문이 닫히고, 복도의 발소리가 멀어졌다."

            "가위 소리가 다시 이어졌다."

    hide taeeun normal with dissolve
    "가위질 소리와 풀 냄새 사이에서, \'오랜만\'이라는 말이 오래 남았다."

    "창밖 노을이 책상 위에서 천천히 식어 간다."

    jump ch2

# 2장 - 균열과 제안
label ch2:
    scene bg hallway with fade
    "다음 날."

    show souen normal at character_size with dissolve
    "복도 끝에서 소은이 걸어오고 있었다."

    "책을 가슴에 끌어안고, 시선은 발끝에 둔 채로."

    "예전에는 어깨에 늘 스케치북이 걸려 있었다."
    "지금 그 어깨는 가볍다."

    "다섯 걸음."

    "소은은 고개를 들지 않았다."
    "나는 속도를 늦추지도, 높이지도 못했다."

    "세 걸음."

    "1년 동안 이 복도에서 수십 번 스쳤다."
    "그때마다 서로 못 본 척했다."
    "말을 꺼내지 않는 것."
    "그게 1년 동안 우리가 지켜 온 방식이었다."

    "한 걸음."

    "교복 소매가 스칠 만큼 가까워졌다."

    menu:
        "\"안녕.\" 소리 내어 인사한다.":
            p "안녕."
            
            show souen surprised at character_size with dissolve
            "소은이 멈칫했다."
            "신발 끝이 바닥에서 반 박자 늦게 떨어졌다."
            
            s "...안녕."

            "아주 작은 목소리였다." 
            "1년 만에 들은 목소리."

        "고개만 끄덕이고 지나친다.":
            "고개를 끄덕였다."
            "소은도 짧게 목례를 했다."
           
            "그게 전부였다."

            "어깨가 스치고, 발소리가 서로 반대쪽으로 갈라졌다"

    hide souen normal with dissolve
    "스쳐 지나가는 순간, 복도의 소리가 꺼졌다."

    scene white with Dissolve(0.5)
    camera at memory_in
    scene bg festival with Dissolve(1.0)

    show souen normal at character_size with dissolve
    s_mem "...또 나중이야?"

    "노을 속으로 걸어 들어가는 교복."
    "점점 작아지는 어깨."

    "붙잡았어야 했던 손목은, 끝내 내 손에 닿지 않았다."

    scene white with Dissolve(0.5)
    camera
    scene bg hallway with Dissolve(1.0)
    "정신을 차렸을 때, 소은의 발소리는 이미 복도 저편으로 멀어져 있었다."

    "나는 복도 한가운데 서서, 아무것도 쥐지 않은 손을 내려다보았다."

    "한참 뒤, 사물함을 열자 접힌 쪽지가 발 아래로 떨어졌다."

    "\'옥상.\' 두 글자뿐이었다."
    "필체는 낯설었다."

    scene bg rooftop_day with fade
    "옥상 문은 원래 잠겨 있어야 한다."
    "그런데 손잡이는 아무 저항 없이 돌아갔다."

    "난간에 기대어 서 있던 사람이 천천히 이쪽을 돌아보았다."
    
    show taeeun normal at character_size with dissolve
    "전학생, 태은."

    t "왔네."

    p "이 문, 원래 잠겨 있잖아."

    t "열어 뒀어. 얘기가 길어질 것 같아서."

    p "…무슨 얘기."

    t "소은이라고 했지."
    t "1년 전 가을 축제날에, 사고를 당한 애."

    "숨이 목에 걸렸다."

    p "너, 월요일에 처음 봤는데. 그걸 어떻게 알아."

    t "그걸 아는 게 내 일이라서."
    t "굳이 부르자면......"

    "태은은 말을 고르듯 하늘을 올려다보았다."

    t "안내원. ...쯤 될까."
    
    p "무슨 안내."

    t "딱 하루."
    t "그날로 돌아갈 수 있어."
    t "대신 매번 뭔가를 내놔야 해."

    p "...야, 너 지금 웹소설 쓰냐?"

    t "웃자고 한 말이면 성공이야."
    t "웃기진 않지만."

    "농담으로 눌러 놓으려던 목소리가 끝에서 갈라졌다."

    t "대가는 언제나 누군가와 얽힌 것이어야 해."
    t "네가 쥐고 있는 사람들과."

    p "...돌아가서 바꿀 수 있으면, 소은이는.."

    t "그건 직접 확인해 봐. "
    t "말로 하면 믿지 않을 거고, 믿으면 더 무서울 테니까."

    "바람이 난간 사이로 지나갔다."
    "운동장 쪽에서 축제 준비의 망치 소리가 희미하게 올라왔다."

    t "그 하루를, 정말 다시 살아볼래?"

    "대답하지 못했다."
    "대답하지 못하는 동안에도, 마음은 이미 한쪽으로 기울어 있었다."

    t "정했으면, 해가 진 뒤에 학교 뒤 골목으로 와."
    t "가로등이 하나뿐인 곳이야."

    "태은은 내 옆을 지나 계단 쪽으로 걸어갔다."
    hide taeeun normal with dissolve

    scene bg alley with fade
    "해가 진 뒤, 나는 그 골목에 서 있었다."

    "이 골목을 끝까지 걸으면 큰길이 나온다." 
    "그날 소은이 걸어간 방향이다."

    show taeeun normal at character_size with dissolve
    "태은은 가로등 아래에서 기다리고 있었다."

    t "왔구나."

    p "...믿는 건 아니야."
    p "그냥, 집에 가도 잠이 안 올 것 같아서."

    t "그걸로 충분해."

    t "첫 번째 대가를 정해야 해. 둘 중 하나만."

    t "소은이와 처음 만난 날의 기억."
    t "아니면 다인이랑 찍은 사진 한 장."

    p "...다인이?"

    t "하나는 네가 돌아가려는 이유고, 하나는 네가 돌아와야 할 곳이니까."

    "휴대폰 갤러리 맨 위에는 지난주에 찍은 사진이 있다."
    "다인이 내 볼을 잡아당기며 웃고 있다."

    "소은과 처음 만난 날은 그 사진보다 훨씬 오래된 기억이다."
    "오래돼서, 닳도록 만져서, 이제는 손가락이 먼저 그곳을 안다."

    p "안 내놓으면?"

    t "되돌릴 수 없어."

    p "둘 다 못 내놓겠다고 하면."

    t "그럼 이대로야. 지금까지처럼."

    "가로등이 한 번 깜박였다."

    "손에 쥔 것 중에서, 하나를 놓아야 한다."

    menu:
        "소은과의 첫 기억만은 지킨다. 대신 다인과의 사진을 내놓는다.":
            jump ch2_keep_souen
        "다인과의 사진만은 지킨다. 대신 소은과의 첫 기억을 내놓는다.":
            jump ch2_keep_dain    

# 2장 1번 분기 - 사진 한 장을 내놓다
label ch2_keep_souen:
    p "...사진으로 해."

    "말하고 나서야, 숨을 참고 있었다는 걸 알았다."

    t "정말로?"

    p "응. 소은이랑 처음 만난 날은, 못 내놓겠어."

    "태은은 고개를 한 번 끄덕였다."
    "나무라는 눈도, 달래는 눈도 아니었다."

    t "휴대폰 꺼내 봐."

    "갤러리의 맨 위의 사진이 가장자리부터 하얗게 녹는다."

    "다인의 웃음이 먼저 사라졌다."
    "그다음이, 영문도 모르고 눈을 감은 내 얼굴이었다."

    "사진이 있던 자리에는 처음부터 다른 사진이 있었다는 듯, 다음 사진이 올라와 있었다."

    "불안해져서 다인에게 문자를 보냈다."

    p "(문자) 우리 지난주에 찍은 사진, 너한테도 있지?"

    "답을 기다리는 동안 눈을 감았다."
    "무언가를 붙들고 있어야 할 것 같았다."

    scene bg park with fade
    camera at memory_in
    "그러자 다른 쪽이 선명해졌다."

    "비가 오는 날이었다."
    "우산이 없어서 공원 나무 밑에 서 있던 아이."

    "노란 우산이 다가왔다."
    "자기 쪽 어깨가 젖는 줄도 모르고, 우산을 절반이나 기울여 주던 아이."

    s_mem "같이 써."

    "그게 소은이 내게 한 첫마디였다."

    "이렇게 또렷했던 적이 없다."
    "손바닥 위에 올려놓을 수 있을 것처럼, 기억이 무게를 가졌다."

    scene bg alley with fade
    camera
    show taeeun normal at character_size with dissolve

    $ item_umbrella = True
    $ renpy.notify("아이템 획득: 노란 우산의 기억")
    
    "눈을 떴다. 답이 와 있었다."

    d "(문자) 무슨 사진? 우리 그런 거 안 찍었는데?"

    d "(문자) 꿈 꿨냐ㅋㅋ"

    "내가 내놓은 건 사진 한 장이 아니었다."
    "사진을 찍던 오후가, 다인의 기억 속에서도 함께 비어 버렸다."

    "손가락이 화면 위에서 한참 머뭇거렸다."
